Options -Indexes -MultiViews

# Leave RewriteBase unset so Apache uses this folder:
# local XAMPP  → /highQhomes/
# Hostinger    → /  (public_html)
RewriteEngine On

# Force HTTPS + apex domain only on the live Hostinger host
RewriteCond %{HTTP_HOST} ^(www\.)?highqhomes\.site$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://highqhomes.site%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.highqhomes\.site$ [NC]
RewriteRule ^ https://highqhomes.site%{REQUEST_URI} [L,R=301]

# Block sensitive files and directories
RewriteRule ^\.env$ - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule ^tmp/ - [F,L]
RewriteRule \.sql$ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^app/ - [F,L]
RewriteRule ^views/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^scripts/ - [F,L]

# Serve existing static files and directories
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Front controller
RewriteRule ^(.*)$ index.php [QSA,L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
