# Copy to .env locally. On Hostinger, create public_html/.env in File Manager.
# Do not commit .env. Put real secrets only on the server.

APP_NAME=HighQ Homes
APP_ENV=production
APP_DEBUG=false
APP_URL=https://highqhomes.site
APP_SECRET=generate-a-long-random-string-on-the-server
ADMIN_LOGIN_PATH=secure-admin-login

# Hostinger MySQL names are usually prefixed (u123456789_highqdb).
# Paste the exact values from hPanel → Databases. Do not guess.
DB_HOST=localhost
DB_NAME=your_hostinger_database
DB_USER=your_hostinger_user
DB_PASS="your_hostinger_password"
DB_CHARSET=utf8mb4

UPLOAD_PATH=uploads
UPLOAD_MAX_SIZE=10485760
