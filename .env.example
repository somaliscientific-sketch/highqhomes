# Development: copy to .env and keep APP_URL on localhost.
# Production (Hostinger): set these values in public_html/.env

APP_NAME=HighQ Homes
APP_ENV=production
APP_DEBUG=false
APP_URL=https://highqhomes.site
APP_SECRET=change-this-to-a-long-random-string
ADMIN_LOGIN_PATH=secure-admin-login

DB_HOST=localhost
DB_NAME=your_hostinger_database
DB_USER=your_hostinger_user
DB_PASS=your_hostinger_password
DB_CHARSET=utf8mb4

UPLOAD_PATH=uploads
UPLOAD_MAX_SIZE=10485760
